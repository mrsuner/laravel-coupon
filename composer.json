{
    "name": "mrsuner/laravel-coupon",
    "type": "library",
    "description": "Coupon lifecycle management (generation, validation, redemption) for Laravel, decoupled from billing via a single event. Works standalone and auto-wires into mrsuner/laravel-api-boilerplate.",
    "keywords": ["laravel", "coupon", "discount", "redemption", "admin", "boilerplate"],
    "license": "MIT",
    "homepage": "https://github.com/mrsuner/laravel-coupon",
    "support": {
        "issues": "https://github.com/mrsuner/laravel-coupon/issues",
        "source": "https://github.com/mrsuner/laravel-coupon"
    },
    "authors": [
        {
            "name": "mrsuner"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "laravel/sanctum": "^4.0",
        "phpunit/phpunit": "^11.5.50|^12.5.8"
    },
    "suggest": {
        "laravel/sanctum": "Required for the default admin-API authentication (auth:sanctum / ability:admin)."
    },
    "autoload": {
        "psr-4": {
            "Mrsuner\\Coupon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mrsuner\\Coupon\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mrsuner\\Coupon\\CouponServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
